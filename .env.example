# Base de datos local: npx prisma dev -d -n barberia (PGlite, una sola BD por puerto; la "shadow" va en el siguiente)
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"
# PGlite solo acepta una conexión; en un Postgres real quita esta línea.
DATABASE_POOL_MAX=1

# Firma de las cookies de sesión
# Genera uno con: openssl rand -base64 32  (la app no arranca sin él)
SESSION_SECRET=""

# URL pública de la app (enlaces en recordatorios)
APP_URL="http://localhost:3000"

# Fotos públicas: obligatorio en producción; vacío usa public/uploads en desarrollo.
BLOB_READ_WRITE_TOKEN=""
# Solo para probar next start en local sin Vercel Blob.
ALLOW_LOCAL_UPLOADS="0"

# Protege /api/cron/reminders
# Genera uno con: openssl rand -base64 32
CRON_SECRET=""

# Recordatorios por correo (Resend). Sin clave, se escriben en la consola.
RESEND_API_KEY=""
EMAIL_FROM="Reservas <reservas@example.com>"

# Recordatorios por WhatsApp (Meta Cloud API). Sin clave, se escriben en la consola.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="recordatorio_cita"
WHATSAPP_TEMPLATE_LANG="es"
# Avisos al barbero: plantillas aprobadas para reserva nueva y cancelación del cliente.
WHATSAPP_TEMPLATE_BARBER_NEW="aviso_reserva_barbero"
WHATSAPP_TEMPLATE_BARBER_CANCEL="aviso_cancelacion_barbero"
