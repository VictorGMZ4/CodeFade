generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Una cuenta puede administrar una o varias barberías.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  mustChangePassword Boolean @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  barbers      Barber[]
}

enum Role {
  OWNER
  STAFF
}

model Membership {
  userId String
  shopId String
  role   Role   @default(OWNER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
}

enum BusinessType {
  BARBERIA
  PELUQUERIA
  UNAS
  ESTETICA
  SPA
  OTRO
}

model Shop {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  // Tipo de negocio; por ahora no modifica las reglas de reserva.
  businessType      BusinessType  @default(OTRO)
  timezone          String        @default("America/Bogota")
  // ISO 4217; los precios se guardan en la unidad mínima (centavos)
  currency          String        @default("COP")
  // Prefijo telefónico por defecto para normalizar números locales
  countryCode       String        @default("57")
  phone             String?
  address           String?
  // Imágenes públicas del negocio, procesadas a WebP.
  logoUrl           String?
  coverUrl          String?
  photos            ShopPhoto[]
  // Cada cuántos minutos se ofrece un turno (15 → 9:00, 9:15, 9:30...)
  slotMinutes       Int           @default(15)
  // Antelación mínima para reservar, en minutos
  leadTimeMinutes   Int           @default(60)
  // Hasta cuántos días hacia adelante se puede reservar
  bookingWindowDays Int           @default(15)
  // Cuántas horas antes de la cita se envía el recordatorio
  reminderHours     Int           @default(24)
  createdAt         DateTime      @default(now())
  memberships       Membership[]
  barbers           Barber[]
  services          Service[]
  customers         Customer[]
  appointments      Appointment[]
  notifications     Notification[]
}

model Barber {
  id           String         @id @default(cuid())
  shopId       String
  userId       String?        @unique
  phone        String?
  // Foto pública del profesional.
  photoUrl     String?
  photos       ShopPhoto[]
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
  notifications Notification[]

  @@index([shopId])
}

// Galería pública del negocio. Conservamos la foto si se elimina su autor.
model ShopPhoto {
  id        String   @id @default(cuid())
  shopId    String
  // Null si el dueño no tiene perfil o se ha eliminado el profesional.
  barberId  String?
  url       String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber    Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

// Franjas de trabajo semanales. Varias por día permiten pausas (p. ej. almuerzo).
model WorkingHours {
  id       String @id @default(cuid())
  barberId String
  // 0 = domingo ... 6 = sábado
  weekday  Int
  // Minutos desde medianoche en la zona horaria de la barbería
  startMin Int
  endMin   Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  startsAt DateTime
  endsAt   DateTime
  reason   String?
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
}

model Service {
  id           String        @id @default(cuid())
  shopId       String
  name         String
  durationMin  Int
  priceCents   Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([shopId])
}

model Customer {
  id           String        @id @default(cuid())
  shopId       String
  name         String
  // Normalizado a E.164 (+573001234567)
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([shopId, phone])
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

// La migración añade una restricción de exclusión que impide que un barbero
// tenga dos citas BOOKED solapadas, incluso con reservas simultáneas.
model Appointment {
  id             String            @id @default(cuid())
  shopId         String
  barberId       String
  serviceId      String
  customerId     String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(ONLINE)
  // Copia del precio al reservar, para que cambiar la tarifa no altere el histórico
  priceCents     Int
  notes          String?
  // Permite al cliente cancelar desde el enlace del recordatorio
  manageToken    String            @unique
  reminderSentAt DateTime?
  notifications  Notification[]
  createdAt      DateTime          @default(now())
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber         Barber            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId, startsAt])
  @@index([shopId, customerId])
  @@index([shopId, barberId, customerId])
  @@index([barberId, startsAt])
  @@index([status, reminderSentAt, startsAt])
}

enum NotificationType {
  NEW_BOOKING
  CLIENT_CANCELLED
  MANUAL_BY_OWNER
}

model Notification {
  id            String           @id @default(cuid())
  shopId        String
  barberId      String
  appointmentId String
  type          NotificationType
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber        Barber          @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([barberId, readAt, createdAt])
}
